DATABASE_URL="postgresql://user:password@localhost:5432/urjin"
PORT=3000

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket-name"
R2_PUBLIC_URL="https://cdn.example.com"
FILE_UPLOAD_MAX_BYTES=26214400

# Required only when running: yarn r2:lifecycle
CLOUDFLARE_API_TOKEN="token-with-workers-r2-storage-write"
R2_LIFECYCLE_PREFIX="uploads/"
